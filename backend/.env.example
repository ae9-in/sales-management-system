# Backend Environment Variables - Copy to .env and fill in actual values

# Database Configuration
TURSO_DB_URL=file:sales.db
TURSO_AUTH_TOKEN=replace_with_turso_auth_token_if_using_cloud

# Authentication Configuration
JWT_SECRET=replace_with_openssl_rand_hex_32
JWT_EXPIRES_IN=24h
SEED_ADMIN_PASSWORD=replace_with_secure_seed_admin_password

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Allowed Origins (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
